# Ambiente
APP_ENV=development

# Controles de execução. Use true/false.
ENABLE_AZURE_PUBLISH=false
ENABLE_SQL_SERVER_LOAD=false
ENABLE_SQL_PIPELINE=false
REQUIRE_DOCUMENTATION=true

# Azure Data Lake Storage Gen2
# Estes identificadores não são credenciais.
AZURE_STORAGE_ACCOUNT=stcustomeranalyticsgb01
AZURE_STORAGE_CONTAINER=customer-analytics

# Estrutura lógica do Data Lake
AZURE_LANDING_PREFIX=00_landing/customer_analytics
AZURE_BRONZE_PREFIX=01_bronze/customer_analytics
AZURE_SILVER_PREFIX=02_silver/customer_analytics
AZURE_GOLD_PREFIX=03_gold/customer_analytics
AZURE_EXPORTS_PREFIX=04_exports/customer_analytics
AZURE_METADATA_PREFIX=metadata
AZURE_QUARANTINE_PREFIX=quarantine

# Fonte utilizada pelo projeto
SOURCE_BLOB_PATH=00_landing/customer_analytics/2026-09-10/FOOD_COMMERCE_DIGITAL_TWIN_v3_DADOS_SUJOS_INTENCIONAIS.xlsx

SOURCE_FILE_NAME=FOOD_COMMERCE_DIGITAL_TWIN_v3_DADOS_SUJOS_INTENCIONAIS.xlsx

SOURCE_SHEET_NAME=25_bronze_transactions_sujo

# Diretórios locais ignorados pelo Git
LOCAL_DATA_DIR=data
LOCAL_OUTPUT_DIR=outputs
LOCAL_TEMP_DIR=temp
LOCAL_LOG_DIR=logs

# SQL Server
CUSTOMER_ANALYTICS_SQL_DRIVER=ODBC Driver 18 for SQL Server
CUSTOMER_ANALYTICS_SQL_SERVER=localhost
CUSTOMER_ANALYTICS_SQL_DATABASE=CustomerAnalyticsHub
# yes usa autenticação integrada do Windows; no usa usuário e senha abaixo.
CUSTOMER_ANALYTICS_SQL_TRUSTED_CONNECTION=yes
CUSTOMER_ANALYTICS_SQL_USER=
CUSTOMER_ANALYTICS_SQL_PASSWORD=

# Documentação gratuita: deterministic não exige IA externa.
# Para IA local opcional, use ollama e mantenha o serviço local ativo.
DOCUMENTATION_PROVIDER=deterministic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
