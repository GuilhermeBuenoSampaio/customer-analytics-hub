# Ambiente da aplicação
APP_ENV=development

# Azure Data Lake Storage Gen2
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_STORAGE_CONTAINER_NAME=customer-analytics

# Prefixos das camadas no contêiner
AZURE_LANDING_PREFIX=00_landing/customer_analytics
AZURE_BRONZE_PREFIX=01.1_bronze_raw/customer_analytics
AZURE_SILVER_PREFIX=02_silver/customer_analytics
AZURE_GOLD_PREFIX=03_gold/customer_analytics
AZURE_GOLD_EXPORTS_PREFIX=03_gold_exports/customer_analytics

# Fonte principal
SOURCE_FILE_NAME=FOOD_COMMERCE_DIGITAL_TWIN_v3_DADOS_SUJOS_INTENCIONAIS.xlsx
SOURCE_SHEET_NAME=25_bronze_transactions_sujo

# Diretórios locais não versionados
LOCAL_DATA_DIR=data
LOCAL_OUTPUT_DIR=outputs
LOCAL_TEMP_DIR=temp
LOCAL_LOG_DIR=logs